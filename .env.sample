API_ID=
API_HASH=
BOT_TOKEN=

# Owner & Sudo Access
# OWNER_USERS_ID: List of owner user IDs (space separated). 
# Formerly OWNER_ID (deprecated but supported)
OWNER_USERS_ID=

# SUDO_USERS_ID: List of sudo user IDs (space separated).
# Formerly SUDO_USERS (deprecated but supported)
SUDO_USERS_ID=

# Logging & Storage
LOG_CHAT_ID=
DB_URI=
MONGO_DB=altruix
MONGO_COLLECTION=mentions_cache

# Bot Configuration
BOT_MODE=
# PREFIX_OWNER_USER: Command prefix for owner/userbot (e.g. ".")
# Formerly CMD_HANDLER (deprecated but supported)
PREFIX_OWNER_USER=.

# PREFIX_SUDO_USERS: Command prefix for sudo users (e.g. "!")
# Formerly SUDO_CMD_HANDLER (deprecated but supported)
PREFIX_SUDO_USERS=!

# Localization
UB_LANG=en

# Sessions (Space separated string sessions)
SESSIONS=