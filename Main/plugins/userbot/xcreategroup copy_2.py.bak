        log_dest = "both"
        if tid in CREATEGROUP_TASKS:
            log_dest = CREATEGROUP_TASKS[tid].get("params", {}).get("log_destination", "both")
        
        pm_bot_lbl = "PM Bot" + (" ✅" if log_dest == "pm_bot" else "")
